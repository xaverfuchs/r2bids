# Helper function. For simplicity it is easier to strip prefixes
strip_prefixes <- function(x, to_replace=c("sub-", "ses-", "task-", "run-")) {
x_stripped <- gsub(paste(to_replace, collapse = "|"), "", x)
return(x_stripped)
}
