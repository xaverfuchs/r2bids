if (!dir.exists(output_dir)) {
dir.create(output_dir, recursive = TRUE)
message(paste("Main BIDS directory successfully created:", output_dir))
}
# Create participants.tsv
participants_data <- unique(data[, c(participant_col, participant_info_cols)])
participants_file <- file.path(output_dir, "participants.tsv")
write.table(participants_data, file = participants_file, sep = "\t", row.names = FALSE, quote = FALSE)
message(paste("Participants data saved:", participants_file))
# Create behavioral data per participant/session/run
for (participant in unique_participants) {
for (session in unique_sessions) {
if (is.na(run_col)) {
# No run column, write one file per participant/session
dir_path <- file.path(sprintf("%s/sub-%s/ses-%s/%s", output_dir, participant, session, datatype))
if (!dir.exists(dir_path)) {
dir.create(dir_path, recursive = TRUE)
message(paste("Folder successfully created:", dir_path))
}
# Filename
task_file <- file.path(dir_path, sprintf("sub-%s_ses-%s_task-%s_%s.tsv",
strip_prefixes(participant),
strip_prefixes(session),
strip_prefixes(task_name),
datatype))
# Subset the data
task_data <- data[data[[participant_col]] == participant & data[[session_col]] == session,
names(data)[!names(data) %in% c(participant_info_cols, participant_col, session_col)],
drop = FALSE]
# Write the file
write.table(task_data, file = task_file, sep = "\t", row.names = FALSE, quote = FALSE)
message(paste("Task data saved:", task_file))
} else {
# Handle multiple runs
for (run in unique_runs) {
dir_path <- file.path(sprintf("%s/sub-%s/ses-%s/%s", output_dir, participant, session, datatype))
if (!dir.exists(dir_path)) {
dir.create(dir_path, recursive = TRUE)
message(paste("Folder successfully created:", dir_path))
}
# Filename including run
task_file <- file.path(dir_path, sprintf("sub-%s_ses-%s_task-%s_run-%s_%s.tsv",
strip_prefixes(participant),
strip_prefixes(session),
strip_prefixes(task_name),
strip_prefixes(run),
datatype))
# Subset the data
task_data <- data[data[[participant_col]] == participant &
data[[session_col]] == session &
data[[run_col]] == run,
names(data)[!names(data) %in% c(participant_info_cols, participant_col, session_col, run_col)],
drop = FALSE]
# Write the file
write.table(task_data, file = task_file, sep = "\t", row.names = FALSE, quote = FALSE)
message(paste("Task data saved:", task_file))
}
}
}
}
}
read_bids <- function(bids_dir, datatype="beh", file_vars=c("sub-", "ses-"), var_names=c("participant", "session"), strip_prefixes=F) {
# 1. Read the participants.tsv file
participants_file <- file.path(bids_dir, "participants.tsv")
if (!file.exists(participants_file)) {
stop("Error: No participants.tsv file found in the BIDS directory.")
}
participants_data <- tryCatch({
read.table(participants_file, sep = "\t", header = TRUE)
}, error = function(e) {
stop(paste("Error: Failed to read participants.tsv file. Reason:", e$message))
})
message("Participants data loaded from: ", participants_file)
# 2. Search for all task-related .tsv files recursively
# Adapt the search pattern to use the user-specified file suffix
task_files <- list.files(bids_dir, pattern = paste0("_", datatype, "\\.tsv$"),
recursive = TRUE, full.names = TRUE)
if (length(task_files) == 0) {
stop("Error: No BIDS task files found for the specified task and file suffix.")
}
# Initialize an empty list to store task data
task_data_list <- list()
# Loop through each task file
for (file in task_files) {
# Read the task file
task_data <- tryCatch({
read.table(file, sep = "\t", header = TRUE)
}, error = function(e) {
stop(paste("Error: Failed to read task file:", file, ". Reason:", e$message))
})
# Extract participant and session info from the file path
file_variables <- unlist(strsplit(basename(file), split = "_")) # By convention the variables are separated by _
# Add variable to the data
for (i in 1:length(file_vars)) {
var <- file_vars[i]
var_name <- var_names[i]
if (strip_prefixes==T) {
task_data[, var_name] <- gsub(var, "", grep(var, file_variables, value = T))
} else {
task_data[, var_name] <- grep(var, file_variables, value = T)
}
}
# Append the task data to the list
task_data_list[[length(task_data_list) + 1]] <- task_data
}
# Combine all task data into one data frame
all_task_data <- do.call(rbind, task_data_list)
# Do some rearrangements
all_task_data <- cbind(all_task_data[, var_names], all_task_data[, !names(all_task_data) %in% var_names, drop=F])
# Report on progress
message("Task data loaded from all task files.")
# 3. Return a list with participants data and the task data
return(list(
participants = participants_data,
task_data = all_task_data
))
}
read_bids <- function(bids_dir, datatype="beh", file_vars=c("sub-", "ses-"), var_names=c("participant", "session"), strip_prefixes=F) {
# 1. Read the participants.tsv file
participants_file <- file.path(bids_dir, "participants.tsv")
if (!file.exists(participants_file)) {
stop("Error: No participants.tsv file found in the BIDS directory.")
}
participants_data <- tryCatch({
read.table(participants_file, sep = "\t", header = TRUE)
}, error = function(e) {
stop(paste("Error: Failed to read participants.tsv file. Reason:", e$message))
})
message("Participants data loaded from: ", participants_file)
# 2. Search for all task-related .tsv files recursively
# Adapt the search pattern to use the user-specified file suffix
task_files <- list.files(bids_dir, pattern = paste0("_", datatype, "\\.tsv$"),
recursive = TRUE, full.names = TRUE)
if (length(task_files) == 0) {
stop("Error: No BIDS task files found for the specified task and file suffix.")
}
# Initialize an empty list to store task data
task_data_list <- list()
# Loop through each task file
for (file in task_files) {
# Read the task file
task_data <- tryCatch({
read.table(file, sep = "\t", header = TRUE)
}, error = function(e) {
stop(paste("Error: Failed to read task file:", file, ". Reason:", e$message))
})
# Extract participant and session info from the file path
file_variables <- unlist(strsplit(basename(file), split = "_")) # By convention the variables are separated by _
# Add variable to the data
for (i in 1:length(file_vars)) {
var <- file_vars[i]
var_name <- var_names[i]
if (strip_prefixes==T) {
task_data[, var_name] <- gsub(var, "", grep(var, file_variables, value = T))
} else {
task_data[, var_name] <- grep(var, file_variables, value = T)
}
}
# Append the task data to the list
task_data_list[[length(task_data_list) + 1]] <- task_data
}
# Combine all task data into one data frame
all_task_data <- do.call(rbind, task_data_list)
# Do some rearrangements
all_task_data <- cbind(all_task_data[, var_names], all_task_data[, !names(all_task_data) %in% var_names, drop=F])
# Report on progress
message("Task data loaded from all task files.")
# 3. Return a list with participants data and the task data
return(list(
participants = participants_data,
task_data = all_task_data
))
}
